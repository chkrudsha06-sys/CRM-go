# 효성CMS 로그인 정보
HYOSUNG_CMS_LOGIN_URL=https://hfs.nsok.co.kr/login
HYOSUNG_CMS_ID=여기에_효성CMS_아이디
HYOSUNG_CMS_PASSWORD=여기에_효성CMS_비밀번호

# CRM 효성CMS 업로드 API
CRM_IMPORT_API_URL=https://crm-go-roan.vercel.app/api/payment-imports/hyosung-cms
CRM_IMPORT_SECRET=vercel에_등록한_HYOSUNG_CMS_IMPORT_SECRET_값

# 조회 기간. 비우면 이번 달 1일~오늘 기준으로 실행합니다.
HYOSUNG_CMS_FROM_DATE=
HYOSUNG_CMS_TO_DATE=

# 브라우저 설정
HEADLESS=false
SLOW_MO_MS=150
DOWNLOAD_DIR=downloads

# 효성CMS 화면 구조가 바뀌거나 버튼 탐지가 안 될 때만 사용합니다.
# 예: HYOSUNG_COLLECTION_URL=https://hfs.nsok.co.kr/...
HYOSUNG_COLLECTION_URL=
